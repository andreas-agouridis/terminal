{
	"extends": "@tsconfig/node20/tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/react",

		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,

		"plugins": [
			{
				"name": "@effect/language-service"
			}
		]
	}
}
